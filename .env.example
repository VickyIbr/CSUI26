# Copy this file to .env, then replace every CHANGE_ME value with a unique secret.
# The real .env must be mode 0600 and is intentionally ignored by Git.

# Optional: set ZENITH_RUNTIME_DIR=./runtime to store postgres/, seaweed/, and secrets/
# inside a single portable folder for easy server migration.
# ZENITH_RUNTIME_DIR=.

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_PASSWORD
POSTGRES_DEFAULT_DATABASE=postgres

SEAWEED_FILERS_DATABASE=seaweedfs_filer
SEAWEED_FILERS_USER=seaweedfs_filer
SEAWEED_FILERS_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_PASSWORD

ZENITH_BACKEND_DATABASE=zenith_backend
ZENITH_BACKEND_USER=zenith_backend
ZENITH_BACKEND_PASSWORD=CHANGE_ME_GENERATE_A_HEX_PASSWORD

SEAWEED_S3_ADMIN_ACCESS_KEY=CHANGE_ME_GENERATE_A_RANDOM_ACCESS_KEY
SEAWEED_S3_ADMIN_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
SEAWEED_S3_ASSETS_ACCESS_KEY=CHANGE_ME_GENERATE_A_RANDOM_ACCESS_KEY
SEAWEED_S3_ASSETS_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
ZENITH_BACKEND_S3_ACCESS_KEY=CHANGE_ME_GENERATE_A_RANDOM_ACCESS_KEY
ZENITH_BACKEND_S3_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Application Auth & Routing
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=7d
SERVICE_URL=http://127.0.0.1
FRONTEND_URL=http://127.0.0.1/studio
ALLOWED_ORIGINS=http://127.0.0.1,http://localhost
ADMIN_NPM_LIST=
S3_PUBLIC_URL=http://127.0.0.1:8333/zenith
VITE_BASE_PATH=/studio/
VITE_API_BASE_URL=/api/v1
